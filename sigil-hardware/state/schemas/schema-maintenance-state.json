{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema-maintenance-state.json",
  "title": "Maintenance Overlay State",
  "description": "Ephemeral operator-maintenance overlay; it never replaces playback ownership state",
  "type": "object",
  "required": [
    "_schema_version",
    "active",
    "reason",
    "since"
  ],
  "properties": {
    "_schema_version": { "const": "1.0" },
    "active": { "type": "boolean" },
    "reason": {
      "type": "string",
      "enum": ["ssh_maintenance"]
    },
    "since": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
