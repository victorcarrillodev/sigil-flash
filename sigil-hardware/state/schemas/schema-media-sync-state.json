{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema-media-sync-state.json",
  "title": "Media Synchronization State",
  "description": "Single-writer state published by radio-fetcher for controlled cache warm-up",
  "type": "object",
  "required": [
    "_schema_version",
    "phase",
    "validated_tracks",
    "total_tracks",
    "priority_cursor",
    "updated_at"
  ],
  "properties": {
    "_schema_version": { "const": "1.0" },
    "phase": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "STREAM_WARMUP",
        "CACHE_ONLY",
        "WAITING_NETWORK",
        "SERVER_UNREACHABLE_USING_CACHE",
        "MEDIA_INTEGRITY_FAILURE",
        "MAINTENANCE",
        "LICENSE_BLOCKED",
        "LICENSE_PURGED"
      ]
    },
    "playlist_id": { "type": ["string", "null"] },
    "generation_id": { "type": ["string", "null"] },
    "validated_tracks": { "type": "integer", "minimum": 0 },
    "total_tracks": { "type": "integer", "minimum": 0 },
    "priority_cursor": { "type": "integer", "minimum": 0 },
    "last_error": { "type": ["string", "null"] },
    "authorization_event": {
      "type": "object",
      "required": ["operation_id", "boot_id", "monotonic_seconds", "result", "http_status", "observed_at"],
      "properties": {
        "operation_id": { "type": "string", "minLength": 1 },
        "boot_id": { "type": "string", "minLength": 1 },
        "monotonic_seconds": { "type": "integer", "minimum": 0 },
        "result": { "enum": ["AUTHENTICATED_PLAYLIST_OK", "TRANSIENT_FAILURE", "AUTHORITATIVE_DENIAL"] },
        "protocol_code": { "type": ["string", "null"] },
        "http_status": { "type": "integer", "minimum": 0, "maximum": 599 },
        "observed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
