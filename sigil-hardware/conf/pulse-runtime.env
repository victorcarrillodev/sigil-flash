# Canonical PulseAudio runtime shared by every SIGIL audio component.
# This path is owned by sigil-pulseaudio.service through RuntimeDirectory and
# therefore does not disappear when an SSH/login session closes.
XDG_RUNTIME_DIR=/run/sigil-pulse
PULSE_RUNTIME_PATH=/run/sigil-pulse
PULSE_SERVER=unix:/run/sigil-pulse/native
