[Unit]
Description=Sigil Radio Fetcher — playlist download, hash verification, atomic swap
After=sigil-local-bootstrap.service network.target
Wants=sigil-local-bootstrap.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=sigil
Group=sigil
Environment=AUDIO_CONF=/etc/sigil/audio.conf
ExecStart=/usr/local/bin/radio-fetcher.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
