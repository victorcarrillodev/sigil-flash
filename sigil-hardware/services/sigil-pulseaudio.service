[Unit]
Description=SIGIL PulseAudio readiness for Bluetooth audio
After=sigil-local-bootstrap.service bluetooth.service bluetooth.target sound.target
Wants=bluetooth.service
Before=audio-manager.service audio-player.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=all
User=sigil
Group=sigil
Environment=HOME=/home/sigil
EnvironmentFile=-/etc/sigil/pulse-runtime.env
RuntimeDirectory=sigil-pulse
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/install -d -o sigil -g sigil -m 0700 /home/sigil/.config/pulse
ExecStart=/usr/local/bin/sigil-pulseaudio-supervisor.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=15
TimeoutStopSec=12
WatchdogSec=45
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
