[Unit]
Description=Sigil first boot identity and secret provisioning
After=sigil-local-bootstrap.service network-online.target
Wants=network-online.target sigil-local-bootstrap.service
ConditionPathExists=!/var/lib/sigil/firstboot_completed.json
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=oneshot
ExecStart=/usr/local/bin/firstboot.sh --once
ExecStartPost=-/bin/systemctl disable sigil-firstboot.service
RemainAfterExit=yes
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
