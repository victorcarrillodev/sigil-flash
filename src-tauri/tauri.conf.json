{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sigil-flash",
  "version": "1.0.0",
  "identifier": "com.sigil.flash",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SIGIL Flash — Estación de Fabricación",
        "width": 960,
        "height": 660,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
